<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Border
        Margin="8"
        Padding="18"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <StackPanel Spacing="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="38"
                    Height="38"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="9">
                    <FontIcon
                        FontSize="19"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE765;" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="字流 Ziliu" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="左键切换中英文 · 右键打开菜单"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.62" />
                </StackPanel>
            </Grid>

            <Border
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="简繁转换" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="切换候选词的简体或繁体输出"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.66" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="CharacterSetToggle"
                        Grid.Column="1"
                        MinWidth="116"
                        OnContent="繁体"
                        OffContent="简体"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Button
                x:Name="OpenSettingsButton"
                Padding="14,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                    <TextBlock Text="打开完整设置" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Grid>
