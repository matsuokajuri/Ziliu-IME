<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,24,0,10" />
        </Style>
        <Style x:Key="RowDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Opacity" Value="0.66" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Grid.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="820"
            Padding="40,32,40,40"
            HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="52"
                    Height="52"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="13">
                    <FontIcon
                        FontSize="25"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE765;" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="3">
                    <TextBlock Text="字流设置" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="调整候选窗口、输入行为和翻页方式"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.66" />
                </StackPanel>
            </Grid>

            <TextBlock Text="候选窗口" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Border Padding="18,15">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="候选词排列" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="选择纵向列表或横向排列" Style="{StaticResource RowDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="LayoutCombo" Grid.Column="1" MinWidth="220" VerticalAlignment="Center">
                                <ComboBoxItem Content="竖排" />
                                <ComboBoxItem Content="横排" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Height="1" Margin="18,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Border Padding="18,15">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="每页候选词数量" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="控制候选窗口一次显示的词条数量" Style="{StaticResource RowDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="CandidateCountCombo" Grid.Column="1" MinWidth="220" VerticalAlignment="Center">
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="6" />
                                <ComboBoxItem Content="7" />
                                <ComboBoxItem Content="8" />
                                <ComboBoxItem Content="9" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="输入行为" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Border Padding="18,15">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="中英文切换按键" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="单独按下该按键时切换输入模式" Style="{StaticResource RowDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="SwitchKeyCombo" Grid.Column="1" MinWidth="220" VerticalAlignment="Center">
                                <ComboBoxItem Content="Shift" />
                                <ComboBoxItem Content="Ctrl" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Height="1" Margin="18,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Border Padding="18,15">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="中文标点" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="选择中文模式下使用全角或半角标点" Style="{StaticResource RowDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="PunctuationToggle"
                                Grid.Column="1"
                                MinWidth="120"
                                OnContent="全角"
                                OffContent="半角"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Height="1" Margin="18,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Border Padding="18,15">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="自动补全成对符号" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="输入左引号、左括号或左书名号时自动补全右侧符号" Style="{StaticResource RowDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoPairToggle"
                                Grid.Column="1"
                                MinWidth="120"
                                OnContent="开启"
                                OffContent="关闭"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="候选翻页" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Border Padding="18,15">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="上一页 / 下一页" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="选择候选窗口的成对翻页按键" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="PageKeyCombo" Grid.Column="1" MinWidth="220" VerticalAlignment="Center">
                            <ComboBoxItem Content="， / 。" />
                            <ComboBoxItem Content="； / ‘" />
                            <ComboBoxItem Content="【 / 】" />
                        </ComboBox>
                    </Grid>
                </Border>
            </Border>

            <InfoBar x:Name="SaveStatus" Margin="0,20,0,0" IsClosable="True" IsOpen="False" />
            <Button
                x:Name="SaveButton"
                Margin="0,16,0,0"
                Padding="24,8"
                HorizontalAlignment="Left"
                Content="保存设置"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</Grid>
