#include <windows.h>

1 VERSIONINFO
 FILEVERSION 0,1,0,1
 PRODUCTVERSION 0,1,0,1
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Ziliu contributors\0"
            VALUE "FileDescription", "Ziliu settings\0"
            VALUE "FileVersion", "0.1.0-alpha.1\0"
            VALUE "InternalName", "ZiliuSettings.exe\0"
            VALUE "LegalCopyright", "Copyright (C) Ziliu contributors\0"
            VALUE "OriginalFilename", "ZiliuSettings.exe\0"
            VALUE "ProductName", "Ziliu\0"
            VALUE "ProductVersion", "0.1.0-alpha.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
