<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ZiliuSettings.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZiliuSettings">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="ZiliuContentFontFamily">Source Han Sans SC</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Source Han Sans SC</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
