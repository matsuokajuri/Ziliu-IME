<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZiliuSettings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZiliuSettings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.Resources>
            <Style x:Key="ZiliuTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource ZiliuContentFontFamily}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="ZiliuSubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource ZiliuContentFontFamily}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="ZiliuBodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource ZiliuContentFontFamily}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="ZiliuCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource ZiliuContentFontFamily}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ZiliuSubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,24,0,10" />
            </Style>
            <Style x:Key="RowDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource ZiliuCaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.66" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid x:Name="SettingsRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="SettingsTitleBar"
                Height="32"
                HorizontalAlignment="Stretch" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    MaxWidth="820"
                    Padding="40,32,40,40"
                    HorizontalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="52"
                            Height="52"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="13">
                            <FontIcon
                                FontSize="25"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE765;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="3">
                            <TextBlock Text="字流设置" Style="{StaticResource ZiliuTitleTextBlockStyle}" />
                            <TextBlock
                                Text="调整候选窗口、输入行为和翻页方式"
                                Style="{StaticResource ZiliuCaptionTextBlockStyle}"
                                Opacity="0.66" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="候选窗口" Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Border Padding="18,15">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="候选词排列" Style="{StaticResource ZiliuBodyTextBlockStyle}" />
                                        <TextBlock Text="选择纵向列表或横向排列" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="LayoutCombo" Grid.Column="1" MinWidth="220" VerticalAlignment="Center">
                                        <ComboBoxItem Content="竖排" />
                                        <ComboBoxItem Content="横排" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Height="1" Margin="18,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Border Padding="18,15">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="每页候选词数量" Style="{StaticResource ZiliuBodyTextBlockStyle}" />
                                        <TextBlock Text="控制候选窗口一次显示的词条数量" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="CandidateCountCombo" Grid.Column="1" MinWidth="220" VerticalAlignment="Center">
                                        <ComboBoxItem Content="3" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="5" />
                                        <ComboBoxItem Content="6" />
                                        <ComboBoxItem Content="7" />
                                        <ComboBoxItem Content="8" />
                                        <ComboBoxItem Content="9" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="输入行为" Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Border Padding="18,15">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="中英文切换按键" Style="{StaticResource ZiliuBodyTextBlockStyle}" />
                                        <TextBlock Text="单独按下该按键时切换输入模式" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="SwitchKeyCombo" Grid.Column="1" MinWidth="220" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Shift" />
                                        <ComboBoxItem Content="Ctrl" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Height="1" Margin="18,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Border Padding="18,15">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="中文标点" Style="{StaticResource ZiliuBodyTextBlockStyle}" />
                                        <TextBlock Text="选择中文模式下使用全角或半角标点" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="PunctuationToggle"
                                        Grid.Column="1"
                                        MinWidth="120"
                                        OnContent="全角"
                                        OffContent="半角"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Height="1" Margin="18,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Border Padding="18,15">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="自动补全成对符号" Style="{StaticResource ZiliuBodyTextBlockStyle}" />
                                        <TextBlock Text="输入左引号、左括号或左书名号时自动补全右侧符号" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="AutoPairToggle"
                                        Grid.Column="1"
                                        MinWidth="120"
                                        OnContent="开启"
                                        OffContent="关闭"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="候选翻页" Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Border Padding="18,15">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="上一页 / 下一页" Style="{StaticResource ZiliuBodyTextBlockStyle}" />
                                    <TextBlock Text="选择候选窗口的成对翻页按键" Style="{StaticResource RowDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="PageKeyCombo" Grid.Column="1" MinWidth="220" VerticalAlignment="Center">
                                    <ComboBoxItem Content="， / 。" />
                                    <ComboBoxItem Content="； / ‘" />
                                    <ComboBoxItem Content="【 / 】" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="QuickMenuRoot" Visibility="Collapsed">
            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="38"
                            Height="38"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="9">
                            <FontIcon
                                FontSize="19"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE765;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="字流 Ziliu" Style="{StaticResource ZiliuSubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="左键切换中英文 · 右键打开菜单"
                                Style="{StaticResource ZiliuCaptionTextBlockStyle}"
                                Opacity="0.62" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="简繁转换" Style="{StaticResource ZiliuBodyTextBlockStyle}" />
                                <TextBlock
                                    Text="切换候选词的简体或繁体输出"
                                    Style="{StaticResource ZiliuCaptionTextBlockStyle}"
                                    Opacity="0.66" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="CharacterSetToggle"
                                Grid.Column="1"
                                MinWidth="116"
                                OnContent="繁体"
                                OffContent="简体"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Button
                        x:Name="OpenSettingsButton"
                        Padding="14,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                            <TextBlock Text="打开完整设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
