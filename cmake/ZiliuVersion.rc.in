#include <windows.h>

1 VERSIONINFO
 FILEVERSION @ZILIU_FILE_VERSION@
 PRODUCTVERSION @ZILIU_FILE_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @ZILIU_VERSION_FILE_TYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Ziliu contributors\0"
            VALUE "FileDescription", "@ZILIU_VERSION_DESCRIPTION@\0"
            VALUE "FileVersion", "@ZILIU_RELEASE_VERSION@\0"
            VALUE "InternalName", "@ZILIU_VERSION_ORIGINAL_FILENAME@\0"
            VALUE "LegalCopyright", "Copyright (C) Ziliu contributors\0"
            VALUE "OriginalFilename", "@ZILIU_VERSION_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "Ziliu\0"
            VALUE "ProductVersion", "@ZILIU_RELEASE_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
